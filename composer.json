{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-simplexml": "*",
        "laravel/framework": "^13.43.0",
        "laravel/nightwatch": "^1.30.6",
        "laravel/tinker": "^3.2.0",
        "league/commonmark": "^2.10.7",
        "spatie/yaml-front-matter": "^2.1.1",
        "torchlight/torchlight-commonmark": ">=0.6",
        "torchlight/torchlight-laravel": "^0.6.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "laravel/pail": "^1.3",
        "laravel/pint": "^1.32.3",
        "nunomaduro/collision": "^8.9.6",
        "pestphp/pest": "^5.3.7",
        "pestphp/pest-plugin-laravel": "^5.0.1"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": [
            "vendor/bin/pint"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "bump:minor": [
            "composer update && composer bump"
        ],
        "lint": [
            "pint"
        ],
        "test:lint": [
            "pint --test"
        ],
        "test:unit": "pest --parallel",
        "test": [
            "@test:lint",
            "@test:unit"
        ]
    }
}
